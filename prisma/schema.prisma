generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  comment   String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InboxMessage {
  id             Int      @id @default(autoincrement())
  telegramUserId String
  username       String?
  message        String
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}
